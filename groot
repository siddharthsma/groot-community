#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_FILE="$SCRIPT_DIR/docker-compose.yml"
ENV_FILE="$SCRIPT_DIR/.env"
MIGRATIONS_DIR="$SCRIPT_DIR/migrations"
RELEASE_REPOSITORY_FILE="$SCRIPT_DIR/RELEASE_REPOSITORY"
INTEGRATION_TOOLS_FILE="$SCRIPT_DIR/lib/integration-tools.sh"
MIGRATION_RUNNER="$SCRIPT_DIR/lib/apply-tracked-migrations.sh"
BUNDLE_VERSION_FILE="$SCRIPT_DIR/VERSION"
INTEGRATIONS_DIR="$SCRIPT_DIR/integrations"
INTEGRATION_ARCHIVES_DIR="$INTEGRATIONS_DIR/archives"

if [[ -f "$INTEGRATION_TOOLS_FILE" ]]; then
  # shellcheck source=/dev/null
  source "$INTEGRATION_TOOLS_FILE"
fi

require_docker_compose() {
  if ! docker compose version >/dev/null 2>&1; then
    echo "Docker Compose is required." >&2
    exit 1
  fi
}

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1" >&2
    exit 1
  fi
}

require_docker() {
  require_cmd docker
}

ensure_env() {
  if [[ ! -f "$ENV_FILE" ]]; then
    echo "Missing $ENV_FILE. Run ./setup-community.sh first." >&2
    exit 1
  fi
}

compose() {
  docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"
}

metadata_artifacts() {
  local metadata_file="$1"
  if [[ ! -f "$metadata_file" ]]; then
    return 0
  fi

  python3 - <<'PY' "$metadata_file"
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
try:
    payload = json.loads(path.read_text())
except Exception:
    raise SystemExit(0)

for plugin in payload.get("plugins", []):
    artifact = str(plugin.get("artifact", "")).strip()
    if artifact:
        print(artifact)
PY
}

detect_supported_plugin_archive() {
  local raw_arch
  raw_arch="$(uname -m)"

  case "$raw_arch" in
    x86_64)
      echo "linux-amd64"
      ;;
    arm64|aarch64)
      echo "linux-arm64"
      ;;
    *)
      echo ""
      ;;
  esac
}

sync_firstparty_plugins() {
  local old_metadata="$1"
  local new_metadata="$2"
  local source_dir="$3"
  local plugin_dir="$4"
  local target_metadata="$5"
  local artifact

  mkdir -p "$plugin_dir"

  while IFS= read -r artifact; do
    [[ -n "$artifact" ]] || continue
    rm -f "$plugin_dir/$artifact"
  done < <(
    {
      metadata_artifacts "$old_metadata"
      metadata_artifacts "$new_metadata"
    } | awk 'NF && !seen[$0]++'
  )

  while IFS= read -r artifact; do
    [[ -n "$artifact" ]] || continue
    if [[ ! -f "$source_dir/$artifact" ]]; then
      echo "Missing first-party plugin artifact: $source_dir/$artifact" >&2
      exit 1
    fi
    cp "$source_dir/$artifact" "$plugin_dir/$artifact"
  done < <(metadata_artifacts "$new_metadata")

  cp "$new_metadata" "$target_metadata"
}

refresh_firstparty_plugin_bundle() {
  local archive_name archive_dir metadata_src plugins_src current_metadata old_metadata
  archive_name="$(detect_supported_plugin_archive)"
  if [[ -z "$archive_name" ]]; then
    echo "Unsupported host architecture: $(uname -m). Groot Community currently supports x86_64, arm64, and aarch64 hosts." >&2
    exit 1
  fi

  archive_dir="$INTEGRATION_ARCHIVES_DIR/$archive_name"
  metadata_src="$archive_dir/first_party_plugins.json"
  plugins_src="$archive_dir/plugins"
  current_metadata="$INTEGRATIONS_DIR/first_party_plugins.json"
  old_metadata="${1:-$current_metadata}"

  if [[ ! -f "$metadata_src" ]]; then
    echo "Missing first-party plugin metadata for $archive_name: $metadata_src" >&2
    exit 1
  fi
  if [[ ! -d "$plugins_src" ]]; then
    echo "Missing first-party plugin archive directory for $archive_name: $plugins_src" >&2
    exit 1
  fi

  sync_firstparty_plugins "$old_metadata" "$metadata_src" "$plugins_src" "$INTEGRATIONS_DIR/plugins" "$INTEGRATIONS_DIR/first_party_plugins.json"
}

get_value() {
  local key="$1"
  local line
  line="$(grep -E "^${key}=" "$ENV_FILE" | tail -n 1 || true)"
  echo "${line#*=}"
}

get_value_from_file() {
  local file="$1"
  local key="$2"
  local line
  if [[ ! -f "$file" ]]; then
    return 0
  fi
  line="$(grep -E "^${key}=" "$file" | tail -n 1 || true)"
  echo "${line#*=}"
}

set_value() {
  local key="$1"
  local value="$2"
  local tmp
  tmp="$(mktemp)"
  awk -v key="$key" -v value="$value" -F= '
    BEGIN { updated = 0 }
    $1 == key { print key "=" value; updated = 1; next }
    { print }
    END { if (!updated) print key "=" value }
  ' "$ENV_FILE" >"$tmp"
  mv "$tmp" "$ENV_FILE"
}

image_version_for_key() {
  local key="$1"
  local ref
  ref="$(get_value "$key")"
  if [[ -z "$ref" ]]; then
    echo "unknown"
    return
  fi
  local without_digest="${ref%@*}"
  local tag="${without_digest##*:}"
  if [[ "$tag" == "$without_digest" || -z "$tag" ]]; then
    echo "unknown"
    return
  fi
  echo "$tag"
}

telemetry_enabled() {
  local value
  value="$(get_value "GROOT_TELEMETRY_ENABLED")"
  value="$(printf '%s' "${value:-}" | tr '[:upper:]' '[:lower:]')"
  [[ "$value" != "false" && "$value" != "0" && "$value" != "no" ]]
}

emit_telemetry_event() {
  ensure_env
  if ! telemetry_enabled; then
    return 0
  fi
  if ! command -v curl >/dev/null 2>&1; then
    return 0
  fi

  local event_name="$1"
  local install_id telemetry_base_url version platform arch
  install_id="$(get_value "GROOT_INSTALL_ID")"
  telemetry_base_url="$(get_value "GROOT_TELEMETRY_BASE_URL")"
  version="$(image_version_for_key "GROOT_API_IMAGE")"
  platform="$(uname -s | tr '[:upper:]' '[:lower:]')"
  arch="$(uname -m | tr '[:upper:]' '[:lower:]')"

  if [[ -z "$install_id" || "$install_id" == "community-install-id" || -z "$telemetry_base_url" ]]; then
    return 0
  fi

  curl -fsS -X POST "${telemetry_base_url%/}/community/install-event" \
    -H 'content-type: application/json' \
    -d "$(python3 - <<'PY' "$install_id" "$event_name" "$version" "$platform" "$arch"
import json
import sys

install_id, event_name, version, platform, arch = sys.argv[1:6]
print(json.dumps({
    "install_id": install_id,
    "event": event_name,
    "version": version,
    "edition": "community",
    "platform": platform,
    "arch": arch,
}))
PY
)" >/dev/null 2>&1 || true
}

get_release_repository() {
  if [[ ! -f "$RELEASE_REPOSITORY_FILE" ]]; then
    echo "Missing $RELEASE_REPOSITORY_FILE. This Community bundle does not know which public release stream to use." >&2
    exit 1
  fi

  local repo
  repo="$(tr -d '[:space:]' <"$RELEASE_REPOSITORY_FILE")"
  if [[ -z "$repo" ]]; then
    echo "Release repository metadata is empty: $RELEASE_REPOSITORY_FILE" >&2
    exit 1
  fi

  echo "$repo"
}

extract_image_parts() {
  local key="$1"
  local expected_suffix="$2"
  local ref
  ref="$(get_value "$key")"
  if [[ -z "$ref" ]]; then
    echo "Missing $key in $ENV_FILE" >&2
    exit 1
  fi

  local without_digest="${ref%@*}"
  local repository="${without_digest%:*}"
  local tag="${without_digest##*:}"
  if [[ "$repository" == "$without_digest" || -z "$repository" || -z "$tag" ]]; then
    echo "$key does not contain a version tag: $ref" >&2
    exit 1
  fi

  if [[ "$repository" != *"/${expected_suffix}" && "$repository" != "$expected_suffix" ]]; then
    echo "$key does not point to the expected image: $ref" >&2
    exit 1
  fi

  if [[ ! "$tag" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]]; then
    echo "$key must use a version-pinned tag, not $tag" >&2
    exit 1
  fi

  printf '%s\t%s\n' "$repository" "$tag"
}

installed_version() {
  ensure_env

  local api_parts ui_parts runtime_parts gateway_parts
  local api_repo api_tag ui_repo ui_tag runtime_repo runtime_tag gateway_repo gateway_tag

  api_parts="$(extract_image_parts "GROOT_API_IMAGE" "groot-community-api")"
  ui_parts="$(extract_image_parts "GROOT_UI_IMAGE" "groot-community-ui")"
  runtime_parts="$(extract_image_parts "AGENT_RUNTIME_IMAGE" "groot-community-agent-runtime")"
  gateway_parts="$(extract_image_parts "AI_GATEWAY_IMAGE" "groot-community-ai-gateway")"

  IFS=$'\t' read -r api_repo api_tag <<<"$api_parts"
  IFS=$'\t' read -r ui_repo ui_tag <<<"$ui_parts"
  IFS=$'\t' read -r runtime_repo runtime_tag <<<"$runtime_parts"
  IFS=$'\t' read -r gateway_repo gateway_tag <<<"$gateway_parts"

  if [[ "$api_tag" != "$ui_tag" || "$api_tag" != "$runtime_tag" || "$api_tag" != "$gateway_tag" ]]; then
    cat >&2 <<EOF
Community image versions are inconsistent in $ENV_FILE.
  GROOT_API_IMAGE=$api_tag
  GROOT_UI_IMAGE=$ui_tag
  AGENT_RUNTIME_IMAGE=$runtime_tag
  AI_GATEWAY_IMAGE=$gateway_tag

Please correct the image tags before running an update.
EOF
    exit 1
  fi

  echo "$api_tag"
}

fetch_latest_release_version() {
  require_cmd curl
  require_cmd python3

  local repo="$1"
  local api_url="https://api.github.com/repos/${repo}/releases/latest"
  local payload
  if ! payload="$(curl -fsSL -H 'Accept: application/vnd.github+json' -H 'User-Agent: groot-community-bundle' "$api_url")"; then
    echo "Failed to fetch latest Community release from $repo" >&2
    exit 1
  fi

  RELEASE_JSON="$payload" python3 - <<'PY'
import json
import os
import re
import sys

payload = os.environ.get("RELEASE_JSON", "")
if not payload:
    print("missing release payload", file=sys.stderr)
    raise SystemExit(1)

try:
    release = json.loads(payload)
except json.JSONDecodeError as exc:
    print(f"invalid release payload: {exc}", file=sys.stderr)
    raise SystemExit(1)

tag = str(release.get("tag_name", "")).strip()
if not tag.startswith("v"):
    print(f"unexpected release tag: {tag}", file=sys.stderr)
    raise SystemExit(1)

version = tag[1:]
if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+(?:[.-][0-9A-Za-z.-]+)?", version):
    print(f"unexpected release version: {version}", file=sys.stderr)
    raise SystemExit(1)

print(version)
PY
}

release_tarball_url() {
  local repo="$1"
  local version="$2"
  echo "https://github.com/${repo}/archive/refs/tags/v${version}.tar.gz"
}

download_release_bundle() {
  local repo="$1"
  local version="$2"
  local target_dir="$3"
  local tarball="$target_dir/community-release.tar.gz"
  local extract_dir="$target_dir/extracted"
  local root

  require_cmd curl
  require_cmd tar

  mkdir -p "$extract_dir"
  curl -fsSL "$(release_tarball_url "$repo" "$version")" -o "$tarball"
  tar -xzf "$tarball" -C "$extract_dir"
  root="$(find "$extract_dir" -mindepth 1 -maxdepth 1 -type d | head -n 1)"
  if [[ -z "$root" || ! -d "$root" ]]; then
    echo "Downloaded Community release archive did not contain an extractable bundle." >&2
    exit 1
  fi

  printf '%s\n' "$root"
}

replace_bundle_from_release() {
  local release_root="$1"
  local preserve_dir="$2"

  mkdir -p "$preserve_dir"

  if [[ -f "$ENV_FILE" ]]; then
    cp "$ENV_FILE" "$preserve_dir/.env"
  fi
  if [[ -f "$INTEGRATIONS_DIR/installed.json" ]]; then
    cp "$INTEGRATIONS_DIR/installed.json" "$preserve_dir/installed.json"
  fi
  if [[ -f "$INTEGRATIONS_DIR/trusted_keys.json" ]]; then
    cp "$INTEGRATIONS_DIR/trusted_keys.json" "$preserve_dir/trusted_keys.json"
  fi
  if [[ -f "$INTEGRATIONS_DIR/first_party_plugins.json" ]]; then
    cp "$INTEGRATIONS_DIR/first_party_plugins.json" "$preserve_dir/first_party_plugins.json"
  fi
  if [[ -d "$INTEGRATIONS_DIR/cache" ]]; then
    cp -R "$INTEGRATIONS_DIR/cache" "$preserve_dir/cache"
  fi
  if [[ -d "$INTEGRATIONS_DIR/plugins" ]]; then
    cp -R "$INTEGRATIONS_DIR/plugins" "$preserve_dir/plugins"
  fi

  find "$SCRIPT_DIR" -mindepth 1 -maxdepth 1 \
    ! -name '.env' \
    ! -name '.git' \
    -exec rm -rf {} +

  tar -C "$release_root" -cf - . | tar -C "$SCRIPT_DIR" -xf -

  mkdir -p "$INTEGRATIONS_DIR"
  if [[ -f "$preserve_dir/.env" ]]; then
    cp "$preserve_dir/.env" "$ENV_FILE"
  fi
  if [[ -f "$preserve_dir/installed.json" ]]; then
    cp "$preserve_dir/installed.json" "$INTEGRATIONS_DIR/installed.json"
  fi
  if [[ -f "$preserve_dir/trusted_keys.json" ]]; then
    cp "$preserve_dir/trusted_keys.json" "$INTEGRATIONS_DIR/trusted_keys.json"
  fi
  if [[ -d "$preserve_dir/cache" ]]; then
    rm -rf "$INTEGRATIONS_DIR/cache"
    cp -R "$preserve_dir/cache" "$INTEGRATIONS_DIR/cache"
  fi
  if [[ -d "$preserve_dir/plugins" ]]; then
    mkdir -p "$INTEGRATIONS_DIR/plugins"
    cp -R "$preserve_dir/plugins/." "$INTEGRATIONS_DIR/plugins/"
  fi
}

sync_image_refs_from_bundle() {
  local bundle_env="$SCRIPT_DIR/.env.example"
  local key value

  for key in GROOT_API_IMAGE GROOT_UI_IMAGE AGENT_RUNTIME_IMAGE AI_GATEWAY_IMAGE; do
    value="$(get_value_from_file "$bundle_env" "$key")"
    if [[ -n "$value" ]]; then
      set_value "$key" "$value"
    fi
  done
}

verify_stack_health() {
  ensure_env
  require_cmd curl

  local http_port ui_port
  http_port="$(get_value "GROOT_HTTP_PORT")"
  ui_port="$(get_value "GROOT_UI_PORT")"
  http_port="${http_port:-8080}"
  ui_port="${ui_port:-3000}"

  local api_url="http://127.0.0.1:${http_port}/readyz"
  local ui_url="http://127.0.0.1:${ui_port}/"
  local attempt

  for attempt in {1..60}; do
    if curl -fsS "$api_url" >/dev/null 2>&1 && curl -fsS "$ui_url" >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done

  echo "Health verification failed." >&2
  echo "  API: $api_url" >&2
  echo "  UI:  $ui_url" >&2
  exit 1
}

show_update_check() {
  ensure_env
  local repo current latest
  repo="$(get_release_repository)"
  current="$(installed_version)"
  latest="$(fetch_latest_release_version "$repo")"

  emit_telemetry_event "update_check"

  echo "Installed version: $current"
  echo "Latest version:    $latest"
  if [[ "$current" == "$latest" ]]; then
    echo "Status: up to date"
  else
    echo "Status: update available"
  fi
}

apply_update() {
  local assume_yes="$1"
  ensure_env
  require_docker_compose
  require_docker
  require_cmd python3

  local repo current latest
  repo="$(get_release_repository)"
  current="$(installed_version)"
  latest="$(fetch_latest_release_version "$repo")"

  if [[ "$current" == "$latest" ]]; then
    echo "Groot Community is already up to date at version $current."
    return 0
  fi

  echo "Installed version: $current"
  echo "Target version:    $latest"

  if [[ "$assume_yes" != "1" ]]; then
    local response
    read -r -p "Proceed with update? [y/N]: " response
    if [[ ! "$response" =~ ^[Yy]$ ]]; then
      echo "Update cancelled."
      return 0
    fi
  fi

  local backup_file="$ENV_FILE.bak.${current}.before-update"
  cp "$ENV_FILE" "$backup_file"

  local temp_dir preserve_dir release_root
  temp_dir="$(mktemp -d)"
  preserve_dir="$temp_dir/preserve"

  local failed_step="download latest Community bundle"
  release_root="$(download_release_bundle "$repo" "$latest" "$temp_dir")"

  failed_step="self-update local Community bundle"
  replace_bundle_from_release "$release_root" "$preserve_dir"

  failed_step="refresh image references from updated bundle"
  sync_image_refs_from_bundle

  failed_step="refresh shipped first-party plugins"
  refresh_firstparty_plugin_bundle "$preserve_dir/first_party_plugins.json"

  failed_step="pull new images"
  if ! compose pull; then
    cat >&2 <<EOF
Community update failed during: $failed_step
Previous version: $current
Target version:   $latest
Backup file:      $backup_file

If you need to recover, restore the previous image references from the backup file
and rerun:
  groot restart
  groot migrate
EOF
    exit 1
  fi

  failed_step="restart Community stack"
  if ! compose up -d --remove-orphans; then
    cat >&2 <<EOF
Community update failed during: $failed_step
Previous version: $current
Target version:   $latest
Backup file:      $backup_file

If you need to recover, restore the previous image references from the backup file
and rerun:
  groot restart
  groot migrate
EOF
    exit 1
  fi

  failed_step="apply migrations"
  if ! run_migrations; then
    cat >&2 <<EOF
Community update failed during: $failed_step
Previous version: $current
Target version:   $latest
Backup file:      $backup_file

If you need to recover, restore the previous image references from the backup file
and rerun:
  groot restart
  groot migrate
EOF
    exit 1
  fi

  failed_step="verify stack health"
  if ! verify_stack_health; then
    cat >&2 <<EOF
Community update failed during: $failed_step
Previous version: $current
Target version:   $latest
Backup file:      $backup_file

If you need to recover, restore the previous image references from the backup file
and rerun:
  groot restart
  groot migrate
EOF
    exit 1
  fi

  if [[ -f "$BUNDLE_VERSION_FILE" ]]; then
    echo "Bundle version: $(cat "$BUNDLE_VERSION_FILE")"
  fi
  echo "Groot Community updated successfully."
  echo "Version: $current -> $latest"
  echo "Backup file: $backup_file"
}

run_migrations() {
  ensure_env
  require_docker_compose
  if [[ ! -d "$MIGRATIONS_DIR" ]]; then
    echo "Missing migrations directory: $MIGRATIONS_DIR" >&2
    exit 1
  fi
  if [[ ! -x "$MIGRATION_RUNNER" ]]; then
    echo "Missing migration runner: $MIGRATION_RUNNER" >&2
    exit 1
  fi

  "$MIGRATION_RUNNER" \
    --migrations-dir "$MIGRATIONS_DIR" \
    --psql-command "docker compose --env-file \"$ENV_FILE\" -f \"$COMPOSE_FILE\" exec -T postgres psql -U groot -d groot"
}

show_help() {
  cat <<'EOF'
Usage: groot <command>

Commands:
  setup [--non-interactive]  Configure .env for the Community bundle
  start                      Start the Community stack and wait for API/UI readiness
  stop                       Stop the Community stack without removing data
  restart                    Restart the Community stack without wiping data
  status                     Show Community stack status
  verify                     Wait for API/UI readiness and exit non-zero on timeout
  logs [service]             Tail logs for all services or one service
  migrate                    Apply pending SQL migrations from the bundle
  integration init <name>    Scaffold a standalone integration plugin repository
  integration build          Build a local plugin repo into the Community bundle
  integration verify         Verify shipped and local plugin artifacts for this bundle
  update --check             Show installed and latest available Community versions
  update [--yes]             Update to the latest Community release
  help                       Show this help text
EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  setup)
    exec "$SCRIPT_DIR/setup-community.sh" "$@"
    ;;
  start)
    ensure_env
    require_docker_compose
    compose up -d --remove-orphans
    verify_stack_health
    ;;
  stop)
    ensure_env
    require_docker_compose
    compose stop
    ;;
  restart)
    ensure_env
    require_docker_compose
    compose stop
    compose up -d --remove-orphans
    run_migrations
    verify_stack_health
    ;;
  status)
    ensure_env
    require_docker_compose
    compose ps
    ;;
  verify)
    verify_stack_health
    ;;
  logs)
    ensure_env
    require_docker_compose
    compose logs -f "$@"
    ;;
  migrate)
    run_migrations
    ;;
  integration)
    if ! declare -f handle_integration_command >/dev/null 2>&1; then
      echo "Integration tooling is unavailable in this bundle." >&2
      exit 1
    fi
    handle_integration_command "$@"
    ;;
  update)
    case "${1:-}" in
      --check)
        show_update_check
        ;;
      --yes)
        apply_update 1
        ;;
      "")
        apply_update 0
        ;;
      *)
        echo "Unknown update option: $1" >&2
        show_help >&2
        exit 1
        ;;
    esac
    ;;
  help|-h|--help)
    show_help
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    show_help >&2
    exit 1
    ;;
esac
